# Credenciais exclusivas para desenvolvimento local. Use segredos próprios fora desse ambiente.
POSTGRES_USER=respawn
POSTGRES_PASSWORD=respawn_local_password
POSTGRES_DB=respawn
POSTGRES_PORT=5432
DATABASE_URL=postgresql://respawn:respawn_local_password@127.0.0.1:5432/respawn?schema=public

# API de autenticação
API_HOST=127.0.0.1
API_PORT=3001
CORS_ORIGIN=http://localhost:5173
# Gere um segredo aleatório; a API recusa valores com menos de 32 bytes.
JWT_SECRET=
JWT_TTL_SECONDS=604800

# Voz e vídeo (LiveKit local via Docker — npm run voice:up)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_at_least_32_characters_long
# IPv4 LAN do host Docker (não use 127.0.0.1). No Windows, consulte com ipconfig.
LIVEKIT_NODE_IP=
# URL PÚBLICA devolvida pela API ao navegador. Use ws:// somente no ambiente
# local; em produção a API exige wss:// para evitar mixed content.
LIVEKIT_URL=ws://127.0.0.1:7880
