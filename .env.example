# Credenciais exclusivas para desenvolvimento local. Use segredos próprios fora desse ambiente.
POSTGRES_USER=respawn
POSTGRES_PASSWORD=respawn_local_password
POSTGRES_DB=respawn
POSTGRES_PORT=5432
DATABASE_URL=postgresql://respawn:respawn_local_password@127.0.0.1:5432/respawn?schema=public

# API de autenticação
API_HOST=127.0.0.1
API_PORT=3001
CORS_ORIGIN=http://localhost:5173
# Gere um segredo aleatório; a API recusa valores com menos de 32 bytes.
JWT_SECRET=
JWT_TTL_SECONDS=604800
