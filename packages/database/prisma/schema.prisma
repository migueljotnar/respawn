generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ChannelType {
  TEXT
  VOICE

  @@map("channel_type")
}

enum Role {
  NOVATO
  PLAYER
  SQUADMATE
  VETERAN
  MVP
  ELITE
  MOD
  ADMIN

  @@map("role")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(320)
  username     String   @unique @db.VarChar(32)
  displayName  String?  @map("display_name") @db.VarChar(64)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  avatarUrl    String?  @map("avatar_url") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions     Session[]
  ownedServers Server[]       @relation("ServerOwner")
  memberships  ServerMember[]
  messages     Message[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  userId     String    @map("user_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model Server {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  iconUrl   String?  @map("icon_url") @db.Text
  ownerId   String   @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner    User           @relation("ServerOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members  ServerMember[]
  channels Channel[]

  @@index([ownerId])
  @@map("servers")
}

model ServerMember {
  serverId String   @map("server_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  nickname String?  @db.VarChar(64)
  role     Role     @default(NOVATO)
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([serverId, userId])
  @@index([userId, joinedAt])
  @@map("server_members")
}

model Channel {
  id        String      @id @default(uuid()) @db.Uuid
  serverId  String      @map("server_id") @db.Uuid
  name      String      @db.VarChar(100)
  type      ChannelType
  topic     String?     @db.VarChar(1024)
  position  Int         @default(0)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  server   Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([serverId, type, position, id])
  @@map("channels")
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  channelId String   @map("channel_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([channelId, createdAt, id])
  @@index([authorId, createdAt])
  @@map("messages")
}
