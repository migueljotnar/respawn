    "jsonwebtoken": "9.0.3",
    "livekit-server-sdk": "^2.18.0",
    "socket.io": "^4.8.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.13.3",
    "socket.io-client": "^4.8.3"
